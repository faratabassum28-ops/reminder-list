MONGO_URI=mongodb://127.0.0.1:27017/reminder_list
PORT=5000
# Comma-separated list of allowed frontend origins in production, e.g.
# https://your-app.vercel.app. Leave unset for local dev (allows all).
FRONTEND_URL=

# Required. A long random string used to sign login sessions — anyone who
# has this can forge a valid login, so keep it secret and never commit a
# real value. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Daily "tasks due tomorrow" reminder emails + the per-doer "Email Tasks"
# button. Gmail with an App Password only — leave blank to keep the
# feature harmless (it'll just log instead of sending).
#
# How to get an App Password:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords, create one (any name), and
#      copy the 16-character password it shows you.
#   3. SMTP_USER is the full Gmail address. SMTP_PASS is that 16-character
#      App Password — NOT the normal Gmail login password (Gmail will
#      reject that).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. A Redis connection string that turns on caching for the
# heaviest-read pages (Doers, Tasks, Settings lists) and stops the
# automatic "generate upcoming occurrences" check from re-running for
# every single person who opens Master — worth setting once more than a
# few people use the app at the same time. Leave blank and the app runs
# exactly as before, just without the speed-up. Any managed free Redis
# works, e.g. a Redis instance on Render or Upstash:
#   REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_URL=

# Required for MySoul Assistant (the chatbot) to answer open-ended questions beyond its
# built-in quick answers. Get a free key at https://aistudio.google.com/apikey
# Leave blank and MySoul Assistant still works — it just tells people AI answers aren't
# turned on yet instead of calling out to Gemini.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash if unset. Set this instead of
# editing code if Google renames/retires the model again later.
GEMINI_MODEL=

# Workshop PMS -> Launch Verification hand-off. When an admin approves a
# workshop, the server POSTs {id,name,days,date,time,day,type} to this Apps
# Script web app (its doPost stores it, its doGet lists them). Leave blank to
# skip the hand-off — approvals still work, the Launches page just shows
# "skipped".
LAUNCH_WEBHOOK_URL=
# Optional. Workshops run on India time (+330 minutes from UTC).
WORKSHOP_TZ_OFFSET_MIN=330

# Help Tickets -> Slack. SLACK_WEBHOOK_URL is an Incoming Webhook for the
# channel tickets are posted to (api.slack.com/apps -> Incoming Webhooks).
# The person must be a MEMBER OF THAT CHANNEL to be pinged.
SLACK_WEBHOOK_URL=
# Optional fallback only — the normal way is the "Slack ID" column in the
# Doer List. JSON keyed by lowercase first name:
#   SLACK_USER_IDS={"dolly":"U01ABCDEF","paridhi":"U02GHIJKL","megha":"U03MNOPQR"}
# Find a Slack member ID: open their profile in Slack -> ⋮ -> Copy member ID.
SLACK_USER_IDS=

# Help Ticket reminders + Slack buttons ("Still Ongoing" / "Resolved").
# Needs the SAME Slack app that owns SLACK_WEBHOOK_URL:
#   1. api.slack.com/apps -> your app -> Interactivity & Shortcuts -> ON
#   2. Request URL: https://<your-backend>/api/slack/interactions
#   3. Basic Information -> Signing Secret -> paste below.
SLACK_SIGNING_SECRET=
# IST hour (0-23) from which reminders may go out each day. Default 9.
TICKET_REMINDER_HOUR=9
# Optional: lets an external scheduler (cron-job.org) hit
#   GET https://<your-backend>/api/slack/reminders?key=<this secret>
# so reminders still fire when a free-tier host has been asleep.
TICKET_CRON_SECRET=

# ======================================================================
# Order Analytics (the 4th app) — runs inside this server. Settings moved
# here from the old standalone Order Analytics server's .env.
# ======================================================================
# Its data lives in its OWN database so it never mixes with the Reminder List's.
#   - Keep your existing Order Analytics data: put its old MONGO_URI here.
#   - Or leave blank: a database called ORDERS_DB_NAME is used on the SAME cluster as MONGO_URI (starts empty, refills from the sheet/Shopify/Shipway).
ORDERS_MONGO_URI=
ORDERS_DB_NAME=mysoul_orders
# 0 = do not run the background sync jobs on this instance.
ORDERS_SYNC=1
# Public address of THIS backend, no trailing slash (Render fills RENDER_EXTERNAL_URL by itself). Used for the Shopify redirect URL.
PUBLIC_URL=
# People get to Order Analytics with their hub login; roles (Admin / Confirmation / Dispatch) are set on the Users page.

# ---- Google Sheet ("Shopify New Order") ----
SHEET_ID=
SHEET_ORDER_TAB=Order Sheet
SHEET_MASTER_TAB=OrdersMaster
# csv = sheet shared as "Anyone with the link can view"; api = private sheet via service account; none = upload CSVs in Settings.
SHEET_SOURCE=csv
SHEET_ORDER_GID=
SHEET_MASTER_GID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
SYNC_INTERVAL_MIN=15
# Secret for GET /api/orders/cron/sync?key=<this> (cron-job.org etc.) and for the Apps Script webhook POST /api/orders/webhook/sheet
CRON_SECRET=
CRON_MIN_AGE_MIN=5

# ---- Shopify ----
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SYNC_INTERVAL_MIN=2
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_EXPIRING_TOKENS=1

# ---- Shipway ----
SHIPWAY_USERNAME=
SHIPWAY_LICENSE_KEY=
SHIPWAY_ORDER_ID_FORMAT=auto
SHIPWAY_SYNC_INTERVAL_MIN=10

# ---- Confirm queue + Dispatch desk ----
FLOW_VIDEO_ENABLED=0

# ======================================================================
# Certificate Studio (the 5th app) — runs inside this server, no settings needed.
# Only for the one-time data move from the old standalone app:
#   npm run migrate:certificates -- --from "<old MONGODB_URI>" [--dry-run]
# (or set this and omit --from)
CERT_OLD_MONGODB_URI=
