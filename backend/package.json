{
  "name": "reminder-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "seed:real": "node seed-real.js",
    "seed:admin": "node seed-admin.js",
    "seed:workshop-user": "node seed-workshop-user.js",
    "seed:workshops": "node seed-workshop-data.js",
    "reset": "node reset-data.js",
    "audit:master": "node audit-master.js",
    "seed:pdf-tasks": "node seed-pdf-tasks.js",
    "reload:tasks": "node seed-pdf-tasks.js --start=2026-10-05 --fresh-master",
    "test:orders": "node --test \"orders/test/*.test.js\"",
    "migrate:certificates": "node certificates/migrate-standalone.js",
    "test:emi": "node --test \"emi/test/*.test.js\"",
    "seed:emi": "node emi/src/seed.js",
    "fix:emi-count": "node emi/src/scripts/normalize-emis.js",
    "test:leadfms": "node leadfms/test/integrations.test.mjs",
    "test:leadfms:flow": "node leadfms/test/flow.test.mjs",
    "test:salesfms": "node salesfms/test/integrations.test.mjs && node --test salesfms/salesDashboard/test/analytics.test.js salesfms/salesDashboard/test/clean.test.js",
    "test:salesfms:flow": "node salesfms/test/flow.test.mjs",
    "close:leadfms": "node leadfms/close-connected.js",
    "close:salesfms": "node salesfms/close-connected.js",
    "migrate:fms-team": "node utils/migrate-fms-team.js"
